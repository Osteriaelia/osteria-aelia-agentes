# Copia este archivo como .env y rellena los valores. Nunca subas .env a GitHub.

# Clave de la API de Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Token del bot que te da @BotFather en Telegram
TELEGRAM_TOKEN=

# Tu número de chat: escribe /start al bot y te lo dirá
TELEGRAM_CHAT_ID_JOSU=

# Tope de gasto por conversación, en dólares (lo decide JOSU)
PRESUPUESTO_SESION_USD=
